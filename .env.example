# Laptop defaults work with no .env file.
# Copy to .env only if you need to override. Never commit real secrets.

# PORT=8002
# HOST=127.0.0.1
# DATABASE_URL=sqlite:///./data/bookings.db

# Temporary password-login bypass (desk acts as Admin). Default off unless set.
# AUTH_DISABLED=1

# --- Twilio (optional booking / invoice SMS) ---
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# US long-code SMS also needs A2P 10DLC Brand/Campaign registration, or messages
# queue then undeliver with error 30034. Toll-Free senders skip 10DLC.
# SMS_ON_BOOKING=0
# BUSINESS_NAME=Barber Shop

# --- SendGrid outbound (password reset + invoice email + /interested leads) ---
# 1. Create a free SendGrid account
# 2. Settings → Sender Authentication → Verify a Single Sender (no domain needed)
# 3. Settings → API Keys → Create API Key (Mail Send permission)
# 4. Paste below, then restart ./start.sh
SENDGRID_API_KEY=
EMAIL_FROM=
# EMAIL_FROM_NAME=Barbershop Demo
# Where /interested ("Want this for your shop?") lead emails go (FROM is EMAIL_FROM).
# INTEREST_NOTIFY_EMAIL=zepedaroberto72@gmail.com
